<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.lab9.HelloController"
            stylesheets="@validation.css"
            prefWidth="600" prefHeight="500">
    <center>
        <VBox spacing="10" alignment="TOP_CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <Label text="Бронирование гостиницы" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="5" alignment="CENTER">
                <!-- ФИО -->
                <Label text="ФИО гостя:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtName" promptText="Имя Фамилия" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="250"/>
                <Label fx:id="lblNameError" styleClass="error-label" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <!-- Тип номера -->
                <Label text="Номер:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cmbRoomType" promptText="Выберите номер" GridPane.rowIndex="2" GridPane.columnIndex="1" prefWidth="250"/>
                <Label fx:id="lblRoomError" styleClass="error-label" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <!-- Дата заезда -->
                <Label text="Заезд (ГГГГ-ММ-ДД):" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCheckIn" promptText="2026-11-01" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label fx:id="lblCheckInError" styleClass="error-label" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <!-- Дата выезда -->
                <Label text="Выезд (ГГГГ-ММ-ДД):" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <TextField fx:id="txtCheckOut" promptText="2026-11-05" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                <Label fx:id="lblCheckOutError" styleClass="error-label" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>

            <!-- Кнопки -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Забронировать" onAction="#onRegister" defaultButton="true"/>
                <Button text="Очистить" onAction="#onClear"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="5">
            <padding><Insets top="10" right="20" bottom="20" left="20"/></padding>
            <Label text="Список бронирований:" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
            <TableView fx:id="tableReservations" prefHeight="180">
                <columns>
                    <TableColumn fx:id="colName" text="ФИО гостя" prefWidth="160"/>
                    <TableColumn fx:id="colRoom" text="Номер" prefWidth="120"/>
                    <TableColumn fx:id="colCheckIn" text="Заезд" prefWidth="130"/>
                    <TableColumn fx:id="colCheckOut" text="Выезд" prefWidth="130"/>
                </columns>
            </TableView>
        </VBox>
    </bottom>
</BorderPane>
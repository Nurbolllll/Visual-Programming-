<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com" xmlns:fx="http://javafx.com"
            fx:controller="kz.atu.lab12.controller.BookController"
            stylesheets="@style.css">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <top>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <padding><Insets bottom="12"/></padding>
            <Label text="📚 Каталог книг" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Поиск:"/>
            <TextField fx:id="txtSearch" promptText="Название или автор..." prefWidth="220"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableBooks">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colId" text="ID" maxWidth="60" minWidth="50"/>
                <TableColumn fx:id="colTitle" text="Название книги" prefWidth="260"/>
                <TableColumn fx:id="colAuthor" text="Автор" prefWidth="200"/>
                <TableColumn fx:id="colYear" text="Год" maxWidth="90" minWidth="70"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="12">
            <padding><Insets top="12"/></padding>
            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="95"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Название:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtTitle" promptText="Например: Мастер и Маргарита" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Автор:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="txtAuthor" promptText="Например: М. А. Булгаков" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Год издания:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtYear" promptText="1450 – 2026" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Добавить" onAction="#onAdd" styleClass="btn-add"/>
                <Button text="Изменить" onAction="#onUpdate" styleClass="btn-update"/>
                <Button text="Удалить" onAction="#onDelete" styleClass="btn-delete"/>
                <Button text="Очистить" onAction="#onClear"/>
                <Button text="Обновить" onAction="#onRefresh"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblStatus" text="Книг в каталоге: 0" styleClass="status-label"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.lab5.HelloController">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>

    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Анкета покупателя (Вариант №8)" />

    <GridPane hgap="10.0" vgap="8.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="90.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="250.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
        <children>
            <Label text="ФИО:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
            <TextField fx:id="txtFullName" promptText="Введите ФИО" GridPane.columnIndex="1" GridPane.rowIndex="0" />

            <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
            <TextField fx:id="txtEmail" promptText="example@mail.com" GridPane.columnIndex="1" GridPane.rowIndex="1" />

            <Label text="Телефон:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
            <TextField fx:id="txtPhone" promptText="+7 (...)" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        </children>
    </GridPane>

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Способ оплаты:" />
        <fx:define>
            <ToggleGroup fx:id="paymentGroup" />
        </fx:define>
        <HBox spacing="15.0">
            <RadioButton fx:id="rbCard" text="Банковская карта" toggleGroup="$paymentGroup" />
            <RadioButton fx:id="rbCash" text="Наличные" toggleGroup="$paymentGroup" />
            <RadioButton fx:id="rbOnline" text="Онлайн-оплата" toggleGroup="$paymentGroup" />
        </HBox>
    </VBox>

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Доставка:" />
        <fx:define>
            <ToggleGroup fx:id="deliveryGroup" />
        </fx:define>
        <HBox spacing="15.0">
            <RadioButton fx:id="rbCourier" text="Курьер" toggleGroup="$deliveryGroup" />
            <RadioButton fx:id="rbPickup" text="Самовывоз" toggleGroup="$deliveryGroup" />
        </HBox>
    </VBox>

    <VBox spacing="5.0">
        <Label style="-fx-font-weight: bold;" text="Дополнительно (опции):" />
        <CheckBox fx:id="chkBox" text="Подарочная упаковка" />
        <CheckBox fx:id="chkBonusCard" text="Оформить бонусную карту" />
        <CheckBox fx:id="chkAgreement" text="Согласен на обработку персональных данных" />
    </VBox>

    <HBox alignment="CENTER" spacing="10.0">
        <Button onAction="#onCreateClick" text="Сформировать" />
        <Button onAction="#onClearClick" text="Очистить" />
        <Button onAction="#onExitClick" text="Выход" />
    </HBox>

    <VBox VBox.vgrow="ALWAYS">
        <Label text="Результат:" />
        <Label fx:id="lblResult" alignment="TOP_LEFT" maxHeight="Infinity" maxWidth="Infinity" style="-fx-border-color: #ccc; -fx-padding: 5; -fx-background-color: #f9f9f9;" VBox.vgrow="ALWAYS" />
    </VBox>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="kz.atu.lab11.controller.BookController"
      style="-fx-background-color: #f4f6f9; -fx-padding: 20;">

    <!-- Шапка приложения -->
    <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="📚 Каталог Библиотеки" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT" spacing="2">
            <Label fx:id="lblCount" text="Найдено книг: 0" style="-fx-font-weight: bold; -fx-text-fill: #7f8c8d;"/>
            <Label fx:id="lblAvgRating" text="Средний рейтинг: 0.0" style="-fx-font-size: 12px; -fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
        </VBox>
    </HBox>

    <!-- Панель поиска и фильтрации -->
    <HBox spacing="10">
        <TextField fx:id="txtSearch" promptText="🔍 Поиск по названию или автору..." HBox.hgrow="ALWAYS"
                   style="-fx-background-radius: 6; -fx-padding: 8;"/>
        <ComboBox fx:id="cmbAuthorFilter" promptText="Фильтр по автору" prefWidth="200"
                  style="-fx-background-radius: 6;"/>
    </HBox>

    <!-- Таблица -->
    <TableView fx:id="tableBooks" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8; -fx-border-color: #dcdde1; -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colTitle" text="Название книги" prefWidth="280"/>
            <TableColumn fx:id="colAuthor" text="Автор" prefWidth="200"/>
            <TableColumn fx:id="colRating" text="Рейтинг (0-5)" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Панель ввода и кнопок (Карточка управления) -->
    <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 8;">
        <Label text="Управление записью" style="-fx-font-weight: bold; -fx-text-fill: #34495e; -fx-font-size: 14px;"/>

        <GridPane hgap="12" vgap="10">
            <Label text="Название:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtTitle" promptText="Введите название" GridPane.columnIndex="1" GridPane.rowIndex="0" HBox.hgrow="ALWAYS"/>

            <Label text="Автор:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtAuthor" promptText="Введите автора" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Рейтинг:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtRating" promptText="Например: 4.5" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 0 0;">
            <Button text="➕ Добавить" onAction="#onAdd" defaultButton="true"
                    style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"/>
            <Button text="✏️ Изменить" onAction="#onUpdate"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"/>
            <Button text="🗑️ Удалить" onAction="#onDelete"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Button text="Очистить поля" onAction="#onClear"
                    style="-fx-background-color: #bdc3c7; -fx-text-fill: #2c3e50; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 12;"/>
        </HBox>
    </VBox>

</VBox>
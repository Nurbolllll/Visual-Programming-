<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="550.0" prefWidth="850.0" xmlns="http://javafx.com" xmlns:fx="http://fxml.com" fx:controller="kz.atu.lab10.NotesController">
    <top>
        <ToolBar prefHeight="40.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <items>
                <Button mnemonicParsing="false" onAction="#onOpen" text="Открыть JSON" />
                <Button mnemonicParsing="false" onAction="#onSave" text="Сохранить JSON" />
            </items>
        </ToolBar>
    </top>
    <left>
        <VBox spacing="10.0" prefWidth="250.0" BorderPane.alignment="CENTER">
            <children>
                <TextField fx:id="txtSearch" promptText="Поиск по заголовку..." />
                <ComboBox fx:id="cmbFilterCategory" prefWidth="250.0" promptText="Фильтр по категории" />
                <ListView fx:id="listNotes" VBox.vgrow="ALWAYS" />
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <GridPane hgap="10.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="100.0" minWidth="10.0" prefWidth="80.0" />
                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <Label text="Заголовок:" />
                        <Label text="Категория:" GridPane.rowIndex="1" />
                        <TextField fx:id="txtTitle" promptText="Введите название конспекта" GridPane.columnIndex="1" />
                        <ComboBox fx:id="cmbCategory" editable="true" prefWidth="200.0" promptText="Выберите или введите" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    </children>
                </GridPane>
                <Label text="Текст конспекта:" />
                <TextArea fx:id="txtBody" promptText="Введите текст учебного материала..." VBox.vgrow="ALWAYS" />
                <HBox spacing="10.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#onAdd" prefWidth="90.0" text="Добавить" />
                        <Button mnemonicParsing="false" onAction="#onEdit" prefWidth="90.0" text="Изменить" />
                        <Button mnemonicParsing="false" onAction="#onDelete" prefWidth="90.0" text="Удалить" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
        </VBox>
    </center>
    <bottom>
        <HBox BorderPane.alignment="CENTER">
            <children>
                <Label fx:id="lblStatus" text="Готово" />
            </children>
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
        </HBox>
    </bottom>
</BorderPane>

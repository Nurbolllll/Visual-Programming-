<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com" xmlns:fx="http://fxml.com" fx:controller="kz.atu.lab08.ColorDialogController">
    <children>
        <ColorPicker fx:id="colorPicker" />
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#onApply" prefWidth="80.0" text="Применить" />
                <Button mnemonicParsing="false" onAction="#onCancel" prefWidth="80.0" text="Отмена" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
